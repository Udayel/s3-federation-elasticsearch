# Kibana > Dev Tools > Console
# Use for self-managed, ECE, or ECK clusters, where federated identity isn't available.
# Keys come from: aws iam create-access-key --user-name elasticsearch-s3-federation

PUT /_query/data_source/s3_federation
{
  "type": "s3",
  "description": "Sample business data for the ES|QL Data Federation blog",
  "settings": {
    "auth": "static_credentials",
    "access_key": "<AWS_ACCESS_KEY_ID>",
    "secret_key": "<AWS_SECRET_ACCESS_KEY>"
  }
}

# 9.5 only: also add  "region": "<BUCKET_REGION>"  to settings.
# 9.6+: "region" on a data source is deprecated and ignored; the bucket region is auto-detected.
