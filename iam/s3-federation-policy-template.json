{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadDatasetObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": ["arn:aws:s3:::${S3_BUCKET_NAME}/${S3_PREFIX}/*"]
    },
    {
      "Sid": "ListBucketForGlobDatasets",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": ["arn:aws:s3:::${S3_BUCKET_NAME}"]
    }
  ]
}
