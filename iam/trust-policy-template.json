{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowElasticDeploymentViaOIDC",
      "Effect": "Allow",
      "Principal": {
        "Federated": "${OIDC_PROVIDER_ARN}"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "${ISSUER_HOST_PATH}:aud": "${JWT_AUDIENCE}",
          "${ISSUER_HOST_PATH}:sub": "${JWT_SUBJECT}"
        }
      }
    }
  ]
}
